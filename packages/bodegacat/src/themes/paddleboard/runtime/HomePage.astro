---
import type { Translations } from "../../../i18n";
import { themeText } from "../../../lib/theme-content";
import type { SiteConfig } from "../../../types/product";

import CTASection from "../CTASection.astro";
import FeatureGrid from "../FeatureGrid.astro";
import Footer from "../Footer.astro";
import Hero from "../Hero.astro";

interface Props {
  siteConfig: SiteConfig;
  t: Translations;
  copyrightYear: number;
  catalogShopHref?: string;
}

const { siteConfig, t, copyrightYear, catalogShopHref = "/shop" } = Astro.props;

const heroTitle =
  themeText(siteConfig, "homeHeadline") || `Welcome to ${siteConfig.name}`;
const heroImage = themeText(siteConfig, "heroImage");
---

<Hero
  title={heroTitle}
  description={siteConfig.description}
  image={heroImage || undefined}
  ctaHref={catalogShopHref}
  ctaText={t.shop.shopNow}
/>

<FeatureGrid
  heading={themeText(siteConfig, "aboutTitle")}
  subheading={themeText(siteConfig, "aboutText")}
  features={[
    {
      title: themeText(siteConfig, "feature1Title", "Safety First"),
      description: themeText(
        siteConfig,
        "feature1Text",
        "Trusted checkout, clear policies, and reliable support.",
      ),
      icon: "🛟",
      accentColor: "primary",
    },
    {
      title: themeText(siteConfig, "feature2Title", "Fast & Simple"),
      description: themeText(
        siteConfig,
        "feature2Text",
        "A streamlined shopping experience that gets out of your way.",
      ),
      icon: "⚡",
      accentColor: "accent",
    },
    {
      title: themeText(siteConfig, "feature3Title", "Built for Adventure"),
      description: themeText(
        siteConfig,
        "feature3Text",
        "Designed to look great on mobile and desktop.",
      ),
      icon: "🌊",
      accentColor: "primary",
    },
  ]}
/>

<CTASection
  title="Ready for your next adventure?"
  description="Browse the shop and find something you’ll love."
  buttonText={t.shop.shopNow}
  buttonHref={catalogShopHref}
/>

<Footer siteConfig={siteConfig} t={t} copyrightYear={copyrightYear} />
