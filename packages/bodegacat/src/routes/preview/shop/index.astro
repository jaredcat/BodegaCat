---
export const prerender = false;

import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar";
import { getTranslations } from "@i18n";
import { previewProductPath } from "@lib/catalog-paths";
import { getProducts, hasUnpublishedDrafts } from "@lib/stripe";
import { loadEffectiveConfig } from "@runtime/cloudflare";
import ThemeShopPage from "@themes/runtime/ShopPage.astro";

const siteConfig = await loadEffectiveConfig();
const t = getTranslations(siteConfig.locale);
const products = await getProducts({ includeUnpublished: true });
const isPreviewCatalogHasDraftProducts = hasUnpublishedDrafts(products);
---

<Layout
  title={t.shop.title}
  siteConfig={siteConfig}
  storefrontPreview={true}
  previewCatalogHasDraftProducts={isPreviewCatalogHasDraftProducts}
>
  <Navbar siteConfig={siteConfig} client:load />
  <ThemeShopPage
    siteConfig={siteConfig}
    products={products}
    t={t}
    productPath={previewProductPath}
  />
</Layout>
