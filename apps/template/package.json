{
  "name": "@bodegacat/template",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Minimal Astro app shell for a Bodega Cat store (publish as a GitHub template)",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro build && wrangler dev --local --config dist/server/wrangler.json",
    "preview:simple": "astro preview",
    "deploy": "astro build && wrangler deploy --config dist/server/wrangler.json",
    "astro": "astro",
    "cf-typegen": "wrangler types worker-configuration/worker-configuration.d.ts",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "catalog:",
    "astro": "catalog:",
    "bodegacat": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@astrojs/ts-plugin": "catalog:",
    "astro-seo-enforcer": "^1.7.0",
    "typescript": "catalog:",
    "wrangler": "^4.145.0"
  }
}
